# KAALA MITHRA - Backend API
# Copy to .env and fill in real values. NEVER commit .env.

PORT=5000
DATABASE_URL=postgres://postgres:<password>@localhost:5432/kaalamithra_db
JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_SETUP_KEY=change-me-to-a-long-random-secret

# --- Deployment (Vercel) ---
# Public URL of the deployed frontend, e.g. https://kaalamithra-app.vercel.app
# (comma-separated list also supported via CORS_ORIGINS). Vercel *.vercel.app
# preview origins are accepted automatically; localhost is always allowed.
FRONTEND_URL=
# CORS_ORIGINS=https://app1.vercel.app,https://app2.vercel.app
# Hosted Postgres (Neon/Supabase/Vercel Postgres) requires TLS. The pool enables
# SSL automatically when NODE_ENV=production or the URL has sslmode=require.
# Override: PGSSL=true / PGSSL=false
# PGSSL=
# Force Secure cookies locally for testing (default: Secure only in production).
# COOKIE_SECURE=
NODE_ENV=development
